# Copy to .env and fill in what you need. Everything is optional.

# SQLite by default. For PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgresql://fitfinder:fitfinder@localhost:5432/fitfinder
DATABASE_URL=sqlite:///./fitfinder.db

# Add a key to have GPT-4o read search queries. Without it the built-in parser is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Load the demo catalog when the database is empty.
AUTO_SEED=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
